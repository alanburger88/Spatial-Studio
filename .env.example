# For the built application; this pack does not start a server.
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173
DATABASE_URL=file:./.data/spatial-studio.sqlite
AI_PROVIDER=offline
# Configure only in the backend environment if a provider is authorized:
# AI_PROVIDER=external
# AI_API_BASE_URL=https://api.your-approved-provider.example
# AI_API_KEY=REPLACE_LOCALLY_AND_NEVER_COMMIT
# AI_MODEL=your-approved-model
# Never expose the API key via VITE_ or browser-side environment variables.
