{
  "name": "infoslips-spatial-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @iss/api dev",
    "dev:web": "pnpm --filter @iss/web dev",
    "start": "node scripts/dev.mjs --preview",
    "build": "pnpm --filter @iss/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "a11y": "playwright test e2e/acceptance.spec.ts --grep AT-34 --trace off",
    "verify:pack": "python3 scripts/verify_pack.py && python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify:app": "python3 scripts/verify_app.py --base-url http://127.0.0.1:3001 --web-url http://127.0.0.1:5173",
    "evidence": "node scripts/evidence.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "axe-core": "4.10.2",
    "pdfjs-dist": "4.9.155",
    "playwright": "1.63.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
