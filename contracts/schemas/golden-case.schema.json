{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "recordId",
    "overrides",
    "expected"
  ],
  "properties": {
    "recordId": {
      "type": "string"
    },
    "overrides": {
      "type": "object"
    },
    "rulePatches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "recordId",
        "documentType",
        "selectedVariants",
        "matchedRuleIds",
        "diagnostics",
        "documentFacts",
        "resultDigest"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
